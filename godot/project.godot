; Battle of Agents — Godot 4.3
;
; Engine configuration is kept here rather than in the editor UI so a clean clone
; plus one CI run reproduces the same project. Scene content is deliberately thin:
; the world is assembled at runtime from the CC0 model kits in res://assets, which
; keeps the repository free of hand-edited .tscn files nobody can review.

config_version=5

[application]

config/name="Battle of Agents"
config/description="Wi-Fi squad combat for Android. LAN only — no server, no account."
config/version="0.2.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.027, 0.047, 1)
boot_splash/show_image=false

[input_devices]

; Godot turns every screen touch into a left mouse click by default, and the
; fire button reads the left mouse button for desktop testing — so a tap
; anywhere on the screen fired the weapon. Touch is touch; a mouse is a mouse.
pointing/emulate_mouse_from_touch=false

[filesystem]

; The supplied map arrives as FBX. Godot 4.3 reads it with ufbx and needs no
; external converter, but the importer is stated here rather than left to a
; default that has moved between releases.
import/fbx/enabled=true
import/blender/enabled=false

[autoload]

Session="*res://scripts/game/session.gd"
Lan="*res://scripts/net/lan_discovery.gd"
NetGame="*res://scripts/net/net_game.gd"
Sfx="*res://scripts/game/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=2
window/vsync/vsync_mode=0

[debug]

; Inference from a Variant is an error by default in 4.3. Kept as a warning so a
; single untyped call cannot fail the whole build; the headless smoke test in CI
; is what actually guards startup.
gdscript/warnings/inference_on_variant=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/untyped_declaration=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="hitboxes"

[physics]

3d/default_gravity=22.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
